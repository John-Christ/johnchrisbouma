    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <style>
        :root {
            --primary: #1a2a3a;
            --secondary: #3498db;
            --text: #333;
            --light: #f4f7f6;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            color: var(--text);
            background: var(--light);
            line-height: 1.6;
        }

        header {
            background: var(--primary);
            color: white;
            padding: 100px 20px;
            text-align: center;
        }

        .container {
            max-width: 1000px;
            margin: auto;
            padding: 20px;
        }

        .profile-title {
            font-size: 2.5rem;
            margin: 0;
            letter-spacing: 2px;
        }

        .subtitle {
            color: var(--secondary);
            font-weight: bold;
            font-size: 1.2rem;
        }

        .section {
            background: white;
            padding: 40px;
            margin: 20px 0;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        h2 {
            border-left: 5px solid var(--secondary);
            padding-left: 15px;
            color: var(--primary);
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .card {
            padding: 20px;
            border: 1px solid #eee;
            border-radius: 5px;
            transition: 0.3s;
        }

        .card:hover {
            border-color: var(--secondary);
            transform: translateY(-5px);
        }

        .tech-pill {
            display: inline-block;
            background: #e1e8ed;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            margin: 5px;
        }

        footer {
            text-align: center;
            padding: 40px;
            background: var(--primary);
            color: white;
        }

        .contact-link {
            color: var(--secondary);
            text-decoration: none;
            font-weight: bold;
        }
    </style>
</head>
